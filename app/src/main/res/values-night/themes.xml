<resources>
    <!-- Dark system theme. Window background matches DarkColors.bg. -->
    <style name="Theme.ExpenseTracker" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0B0B0D</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Android 12+ system splash: app mark centred on the window background, then the app theme. -->
    <style name="Theme.ExpenseTracker.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0B0B0D</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="windowSplashScreenIconBackgroundColor">#98BBF4</item>
        <item name="postSplashScreenTheme">@style/Theme.ExpenseTracker</item>
    </style>
</resources>
